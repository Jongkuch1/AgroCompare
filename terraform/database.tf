# Owner: AgertuDA (Summative Part 2: container registry, managed database, security gates)
# Managed PostgreSQL (Azure Database for PostgreSQL, flexible server).
# It lives in its own subnet inside the virtual network and has NO public
# access: only machines inside the network (the app VM) can connect.
#
# This file relies on names from main.tf and network.tf (Jongkuch1):
# local.name_prefix, local.common_tags, azurerm_resource_group.main,
# azurerm_virtual_network.main.

variable "db_subnet_prefix" {
  description = "Subnet reserved for the database (inside vnet_address_space, not used by anything else)."
  type        = string
  default     = "10.20.3.0/24"
}

variable "db_sku_name" {
  description = "Database size. B_Standard_B1ms is the smallest and cheapest."
  type        = string
  default     = "B_Standard_B1ms"
}

variable "db_name" {
  description = "Name of the application database."
  type        = string
  default     = "agrocompare"
}

variable "db_admin_username" {
  description = "Database administrator login."
  type        = string
  default     = "agroadmin"
}

# The password is generated by Terraform, never typed or committed.
# Read it after apply with:  terraform output -raw db_admin_password
resource "random_password" "db" {
  length           = 24
  special          = true
  override_special = "-_"
}

resource "azurerm_subnet" "db" {
  name                 = "${local.name_prefix}-db-subnet"
  resource_group_name  = azurerm_resource_group.main.name
  virtual_network_name = azurerm_virtual_network.main.name
  address_prefixes     = [var.db_subnet_prefix]

  delegation {
    name = "postgres-flexible-server"

    service_delegation {
      name    = "Microsoft.DBforPostgreSQL/flexibleServers"
      actions = ["Microsoft.Network/virtualNetworks/subnets/join/action"]
    }
  }
}

# Allow PostgreSQL (5432) from the app subnet. Azure's default rules still allow other traffic inside the virtual network.
resource "azurerm_network_security_group" "db" {
  name                = "${local.name_prefix}-db-nsg"
  location            = azurerm_resource_group.main.location
  resource_group_name = azurerm_resource_group.main.name
  tags                = local.common_tags

  security_rule {
    name                       = "allow-postgres-from-app-subnet"
    priority                   = 100
    direction                  = "Inbound"
    access                     = "Allow"
    protocol                   = "Tcp"
    source_port_range          = "*"
    destination_port_range     = "5432"
    source_address_prefix      = var.private_subnet_prefix
    destination_address_prefix = "*"
  }
}

resource "azurerm_subnet_network_security_group_association" "db" {
  subnet_id                 = azurerm_subnet.db.id
  network_security_group_id = azurerm_network_security_group.db.id
}

# Private DNS so the VM can find the database by name inside the network
resource "azurerm_private_dns_zone" "db" {
  name                = "${var.project_name}.postgres.database.azure.com"
  resource_group_name = azurerm_resource_group.main.name
  tags                = local.common_tags
}

resource "azurerm_private_dns_zone_virtual_network_link" "db" {
  name                  = "${local.name_prefix}-db-dns-link"
  private_dns_zone_name = azurerm_private_dns_zone.db.name
  resource_group_name   = azurerm_resource_group.main.name
  virtual_network_id    = azurerm_virtual_network.main.id
  tags                  = local.common_tags
}

resource "random_string" "db_suffix" {
  length  = 4
  upper   = false
  special = false
}

resource "azurerm_postgresql_flexible_server" "main" {
  # Accepted risks (cost and course scope):
  #checkov:skip=CKV_AZURE_136:Geo-redundant backup costs extra and is not needed for a demo
  #checkov:skip=CKV2_AZURE_57:Private access is used instead (no public network access)

  name                = "${local.name_prefix}-db-${random_string.db_suffix.result}"
  resource_group_name = azurerm_resource_group.main.name
  location            = azurerm_resource_group.main.location
  version             = "16"

  delegated_subnet_id           = azurerm_subnet.db.id
  private_dns_zone_id           = azurerm_private_dns_zone.db.id
  public_network_access_enabled = false

  administrator_login    = var.db_admin_username
  administrator_password = random_password.db.result

  sku_name   = var.db_sku_name
  storage_mb = 32768

  backup_retention_days = 7

  tags = local.common_tags

  depends_on = [azurerm_private_dns_zone_virtual_network_link.db]
}

resource "azurerm_postgresql_flexible_server_database" "app" {
  name      = var.db_name
  server_id = azurerm_postgresql_flexible_server.main.id
  charset   = "UTF8"
  collation = "en_US.utf8"
}

output "db_host" {
  description = "Database address, reachable only from inside the virtual network (GitHub variable DB_HOST)."
  value       = azurerm_postgresql_flexible_server.main.fqdn
}

output "db_name" {
  description = "Name of the application database."
  value       = azurerm_postgresql_flexible_server_database.app.name
}

output "db_admin_username" {
  description = "Database administrator login."
  value       = var.db_admin_username
}

output "db_admin_password" {
  description = "Database administrator password (GitHub secret DB_PASSWORD). Shown only with: terraform output -raw db_admin_password"
  value       = random_password.db.result
  sensitive   = true
}
