# Rendered by Ansible from the deploy role's template - edit the .j2 source, not this file.
services:
  backend:
    image: "{{ acr_login_server }}/agrocompare-backend:{{ image_tag }}"
    environment:
      FLASK_DEBUG: "0"
    ports:
      - "5000:5000"
    networks:
      - agro-net
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:5000/api/health', timeout=3)"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s

  frontend:
    image: "{{ acr_login_server }}/agrocompare-frontend:{{ image_tag }}"
    ports:
      - "{{ app_port }}:80"
    depends_on:
      backend:
        condition: service_healthy
    networks:
      - agro-net
    restart: unless-stopped

networks:
  agro-net:
    driver: bridge
